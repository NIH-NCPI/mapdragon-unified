# Copy to .env (which is git-ignored) and fill in values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required at runtime
# ---------------------------------------------------------------------------
UMLS_API_KEY=

# ---------------------------------------------------------------------------
# Build-time (baked into the front end)
# ---------------------------------------------------------------------------
# OAuth2 client ID. For login to work locally, the client must allow
# http://localhost:8080 as an authorized origin / redirect.
VITE_CLIENT_ID=

# Leave these unset to use the commits pinned in the Dockerfile (i.e. what
# would be deployed). Set them to test a different front/back end combination.
# MAPDRAGON_COMMIT=
# VITE_MAPDRAGON_VERSION=
# LOCUTUS_COMMIT=
# DEPLOY_ENV=local

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave MONGO_URI unset to use the bundled local mongo service.
# These configure that local service:
# MONGO_ROOT_USER=locutus
# MONGO_ROOT_PASSWORD=locutus
# MONGO_DB_NAME=locutus
# MONGO_PORT=27017

# To test against a remote DB, set MONGO_URI and run:
#   docker compose up --build --no-deps app
#
# GCP - Firestore with MongoDB compatibility (URL-encode '#' as %23):
# MONGO_URI=mongodb://USER:PASS@PROJECT.REGION.firestore.goog:443/DATABASE?tls=true&retryWrites=false&loadBalanced=true&authMechanism=SCRAM-SHA-256&authMechanismProperties=ENVIRONMENT:gcp,TOKEN_RESOURCE:FIRESTORE
#
# AWS - DocumentDB. The image ships the RDS CA bundle at /global-bundle.pem.
# DocumentDB is VPC-only; from a laptop, tunnel through a bastion and use
# host.docker.internal plus tlsAllowInvalidHostnames=true, e.g.
#   ssh -N -L 27017:CLUSTER.docdb.amazonaws.com:27017 user@bastion
# MONGO_URI=mongodb://USER:PASS@host.docker.internal:27017/locutus?tls=true&tlsCAFile=/global-bundle.pem&tlsAllowInvalidHostnames=true&directConnection=true&retryWrites=false
# (Use a MONGO_PORT other than 27017 above if the local mongo service is also running.)

# ---------------------------------------------------------------------------
# Optional runtime / local settings
# ---------------------------------------------------------------------------
# VERSION=local
# LOCUTUS_LOGLEVEL=INFO
# APP_PORT=8080
# IMAGE_TAG=local
# Cloud targets are amd64; use linux/arm64 on Apple Silicon for faster builds.
# DOCKER_PLATFORM=linux/amd64
